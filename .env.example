# Gemini API Key (Lấy từ Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Web API Key (Lấy từ Firebase Console -> Project Settings -> General)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# Đường dẫn tới file Service Account (Mặc định ở thư mục backend)
FIREBASE_SERVICE_ACCOUNT_PATH=backend/serviceAccountKey.json

# Cấu hình ứng dụng
APP_ENV=development
DEBUG=True
