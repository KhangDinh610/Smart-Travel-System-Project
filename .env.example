# --- Backend Configuration ---
# GEMINI AI API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# Path to Firebase Service Account JSON (DO NOT COMMIT THE REAL FILE)
FIREBASE_SERVICE_ACCOUNT_PATH="backend/serviceAccountKey.json"

# Firebase Web API Key (For email/password login)
FIREBASE_WEB_API_KEY="your_firebase_web_api_key_here"

# Database URL
DATABASE_URL=sqlite:///./backend/test.db

# Environment (development/production)
APP_ENV=development

# --- Frontend Configuration (Vite) ---
VITE_FIREBASE_API_KEY="your_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="1:xxxx:web:xxxx"
VITE_FIREBASE_MEASUREMENT_ID="G-xxxxxx"
